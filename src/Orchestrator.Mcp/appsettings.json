{
    "Urls": "http://localhost:5000",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Warning"
        }
    },
    "OllamaNode": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 120
    },
    "OllamaNodeB": {
        "BaseUrl": "http://unreachable.local:11434",
        "TimeoutSeconds": 5,
        "_comment": "TimeoutSeconds=5: fast-fail when NodeB is unreachable. Prevents 4-min hang on refactor_code/generate_tests. Fallback chain: B→C→A handles routing automatically. Increase to 30 only if Node B is reliably reachable on your LAN."
    },
    "CopilotNode": {
        "Model": "gpt-4o-mini-copilot",
        "TimeoutSeconds": 60
    },
    "ToolOptions": {
        "RefactorTimeoutSeconds": 45,
        "GenerateTestsTimeoutSeconds": 60,
        "SearchCodebaseTimeoutSeconds": 60,
        "AgentTaskTimeoutSeconds": 300
    }
}
