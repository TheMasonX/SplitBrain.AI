{
    "Urls": "http://localhost:5000",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Warning"
        }
    },
    "OllamaNode": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 120
    },
    "OllamaNodeB": {
        "BaseUrl": "http://unreachable.local:11434",
        "TimeoutSeconds": 5,
        "_comment": "TimeoutSeconds=5: fast-fail for unreachable Node B — prevents 4-min cascade. See docs/DIAGNOSTICS.md."
    },
    "CopilotNode": {
        "Model": "gpt-4o-mini-copilot",
        "TimeoutSeconds": 60
    },
    "Mcp": {
        "WriteAccess": {
            "Mode": "Disabled",
            "_comment": "Disabled = no writes; PerCallEnable = require enable_write:true per call; AlwaysEnabled = unrestricted. Default: Disabled.",
            "AllowedWriteTools": []
        }
    },
    "ToolOptions": {
        "RefactorTimeoutSeconds": 45,
        "GenerateTestsTimeoutSeconds": 60,
        "SearchCodebaseTimeoutSeconds": 60,
        "AgentTaskTimeoutSeconds": 300
    }
}
