@page "/"
@rendermode InteractiveServer
@inject DashboardState State
@implements IDisposable
@using ApexCharts

<PageTitle>Overview — SplitBrain.AI</PageTitle>

<h1>Cluster Overview</h1>

@if (State.ActiveAlerts.Any())
{
    <div class="sb-alerts">
        @foreach (var alert in State.ActiveAlerts)
        {
            var alertClass = alert.Severity switch
            {
                "Critical" or "Error" => "sb-alert-critical",
                "Warning" => "sb-alert-warning",
                _ => "sb-alert-info"
            };
            <div class="sb-alert @alertClass">
                <span class="sb-alert-severity">@alert.Severity</span>
                @if (alert.NodeId is not null)
                {
                    <span class="sb-tag">@alert.NodeId</span>
                }
                <span class="sb-alert-msg">@alert.Message</span>
                <span class="sb-alert-time">@alert.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                <button class="sb-btn-dismiss" @onclick="() => State.DismissAlert(alert.AlertId)" title="Dismiss">?</button>
            </div>
        }
    </div>
}

@if (!State.NodeHealth.Any())
{
    <p class="sb-muted">Waiting for health data…</p>
}
else
{
    <div class="sb-node-grid">
        @foreach (var (nodeId, snapshot) in State.NodeHealth.OrderBy(kv => kv.Key))
        {
            var stateClass = snapshot.Health.State switch
            {
                HealthState.Healthy => "sb-healthy",
                HealthState.Degraded => "sb-degraded",
                _ => "sb-unavailable"
            };
            <div class="sb-node-card @stateClass">
                <div class="sb-node-header">
                    <span class="sb-led"></span>
                    <strong>@snapshot.DisplayName</strong>
                    <span class="sb-badge">@snapshot.Health.State</span>
                </div>
                <div class="sb-node-body">
                    <div>Latency: <b>@snapshot.Health.LatencyMs.ToString("F0") ms</b></div>
                    <div>Active: <b>@snapshot.Health.ActiveRequests</b></div>
                    @if (snapshot.Health.VramTotalMB is > 0)
                    {
                        var used  = snapshot.Health.VramLoadedMB ?? 0;
                        var total = snapshot.Health.VramTotalMB!.Value;
                        var pct   = total > 0 ? Math.Round((double)used / total * 100, 1) : 0.0;
                        var gaugeColor = pct > 90 ? "#ef4444" : pct > 70 ? "#eab308" : "#22c55e";
                        var gaugeOpts = BuildVramGaugeOptions(gaugeColor);
                        var gaugeData = new List<VramGaugePoint> { new((decimal)pct) };

                        <div class="sb-vram-gauge-wrap">
                            <ApexChart TItem="VramGaugePoint"
                                       Options="gaugeOpts"
                                       Height="110"
                                       Width="130">
                                <ApexPointSeries TItem="VramGaugePoint"
                                                 Items="gaugeData"
                                                 SeriesType="SeriesType.RadialBar"
                                                 Name="VRAM"
                                                 YValue="@(p => p.Pct)" />
                            </ApexChart>
                            <div class="sb-vram-label">@used / @total MB</div>
                        </div>
                    }
                    @if (snapshot.Health.RunningModels.Any())
                    {
                        <div class="sb-models">
                            @foreach (var m in snapshot.Health.RunningModels)
                            {
                                <span class="sb-tag">@m.ModelId</span>
                            }
                        </div>
                    }
                    @if (snapshot.Health.ErrorMessage is not null)
                    {
                        <div class="sb-error">@snapshot.Health.ErrorMessage</div>
                    }
                </div>
                <div class="sb-node-footer">Updated @snapshot.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized() =>
        State.OnChange += StateHasChanged;

    public void Dispose() =>
        State.OnChange -= StateHasChanged;

    private static ApexChartOptions<VramGaugePoint> BuildVramGaugeOptions(string color) => new()
    {
        Theme = new Theme { Mode = Mode.Dark },
        Chart = new Chart
        {
            Background = "transparent",
            Toolbar   = new Toolbar { Show = false },
            Sparkline = new ChartSparkline { Enabled = true },
            Animations = new Animations { Enabled = false }
        },
        PlotOptions = new PlotOptions
        {
            RadialBar = new PlotOptionsRadialBar
            {
                StartAngle = -120,
                EndAngle   = 120,
                Hollow     = new Hollow { Size = "60%" },
                Track      = new Track { Background = "#2e3148", Width = 100 },
                DataLabels = new RadialBarDataLabels
                {
                    Show  = true,
                    Name  = new RadialBarDataLabelsName  { Show = false },
                    Value = new RadialBarDataLabelsValue
                    {
                        Show      = true,
                        FontSize  = "14px",
                        FontWeight = "700",
                        Color     = "#e2e8f0",
                        Formatter = "function(v){return v.toFixed(0)+'%'}"
                    }
                }
            }
        },
        Colors = [color],
        Tooltip = new Tooltip { Enabled = false }
    };
}
